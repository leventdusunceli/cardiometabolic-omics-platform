# Copy to .env and adjust if needed. All values below are safe local defaults;
# this project only ever talks to public data sources, so no real secrets belong here.

DATABASE_URL=postgresql+psycopg://cmo:cmo@localhost:5432/cmo_platform
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Used by docker-compose to initialize the Postgres container.
POSTGRES_USER=cmo
POSTGRES_PASSWORD=cmo
POSTGRES_DB=cmo_platform